@{ ViewData["Title"] = "Bảng điều khiển"; var d = (TraceDash)ViewBag.Dash; }
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-muted small">Sản phẩm</div><div class="stat-num">@d.Products</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-muted small">Đơn vị truy xuất</div><div class="stat-num" style="color:#ca8a04">@d.Units</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-muted small">Sự kiện đã ghi</div><div class="stat-num">@d.Events</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-muted small">Đã đến tay NTD</div><div class="stat-num text-success">@d.Completed</div></div></div></div>
</div>
<div class="card"><div class="card-body">
    <h6 class="fw-bold mb-3">Đơn vị theo giai đoạn chuỗi cung ứng</h6>
    @foreach (var (stage, cnt) in d.ByStage)
    {
        var (txt, css, icon) = Ui.Stage(stage);
        var pct = d.Units == 0 ? 0 : cnt * 100 / d.Units;
        <div class="d-flex align-items-center mb-2">
            <div style="width:130px" class="small"><i class="bi @icon me-1"></i>@txt</div>
            <div class="flex-fill"><div class="progress" style="height:16px"><div class="progress-bar bg-@css" style="width:@Math.Max(pct,3)%">@cnt</div></div></div>
        </div>
    }
    <a href="/Unit" class="btn btn-primary mt-2"><i class="bi bi-plus-lg me-1"></i>Tạo đơn vị truy xuất</a>
    <a href="/Trace" target="_blank" class="btn btn-outline-primary mt-2 ms-1"><i class="bi bi-search me-1"></i>Trang tra cứu công khai</a>
</div></div>
