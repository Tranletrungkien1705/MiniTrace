@model List<Product>
@{ ViewData["Title"] = "Sản phẩm"; }
<div class="row g-3">
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Thêm sản phẩm</h6>
        <form asp-action="Create" method="post">@Html.AntiForgeryToken()
            <div class="mb-2"><input name="name" class="form-control" placeholder="Tên sản phẩm *" required /></div>
            <div class="mb-2"><input name="code" class="form-control" placeholder="GTIN (tự sinh nếu trống)" /></div>
            <div class="mb-2"><input name="origin" class="form-control" placeholder="Xuất xứ" /></div>
            <div class="mb-3"><input name="manufacturer" class="form-control" placeholder="Nhà sản xuất" /></div>
            <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Thêm</button>
        </form>
    </div></div></div>
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <table class="table table-hover align-middle"><thead><tr><th>GTIN</th><th>Tên</th><th>Xuất xứ</th><th>Nhà SX</th></tr></thead><tbody>
        @foreach (var p in Model) { <tr><td class="fw-semibold">@p.Code</td><td>@p.Name</td><td class="small">@p.Origin</td><td class="small text-muted">@p.Manufacturer</td></tr> }
        @if (Model.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-4">Chưa có sản phẩm.</td></tr> }
        </tbody></table>
    </div></div></div>
</div>
