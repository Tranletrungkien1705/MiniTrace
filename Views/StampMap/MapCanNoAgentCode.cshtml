@model List<ScanRow>
@{
    // Tiêu đề lấy nguyên văn nguồn: MapCanNoAgentCode.cshtml:3
    ViewData["Title"] = "Xuất hàng";
    var scanText = (string?)ViewBag.ScanText ?? "";
    var scanned = scanText.Replace("\r\n", "\n").Split('\n', StringSplitOptions.RemoveEmptyEntries);
}
<h1 class="h5 fw-bold mb-3">Xuất hàng
    <span class="text-muted fw-normal" style="font-size:13px">(port 1:1 MapCanNoAgentCode.cshtml — Inv_InventoryBalanceSerial)</span>
</h1>

<div class="card mb-3"><div class="card-body">
    <div class="small text-muted mb-2">
        "Xuất hàng (Trừ kho thành phẩm)" — thứ tự quét ĐÚNG: <b>Mã thùng → Mã đại lý</b>
        (nguồn Inv_InventoryBalanceSerialController.cs:3802). Dòng bắt đầu bằng một trong các tiền tố
        <code>@MiniTrace.Services.StampMapService.PrefixCask</code> là mã thùng (nguồn dòng 3893-3920);
        mọi dòng khác là mã đại lý. Xuất theo thùng ⇒ trừ kho <b>toàn bộ tem trong thùng</b>.
    </div>
    <form asp-action="ImportCanNoAgentCode" method="post">@Html.AntiForgeryToken()
        <textarea name="scanText" rows="6" class="form-control font-monospace" style="font-size:12.5px"
                  placeholder="THU-0001&#10;THU-0002&#10;DL-HN01">@scanText</textarea>
        <button class="btn btn-primary mt-2"><i class="bi bi-upload me-1"></i>Import (dữ liệu máy quét)</button>
    </form>
</div></div>

<form asp-action="SaveCanNoAgentCode" method="post">@Html.AntiForgeryToken()
<input type="hidden" name="scanText" value="@scanText" />
<div class="row g-3">
    <div class="col-lg-4"><div class="card h-100"><div class="card-body">
        <h6 class="fw-bold mb-2">Dữ liệu máy quét</h6>
        <table class="table table-sm table-bordered mb-0"><tbody>
        @foreach (var l in scanned) { <tr><td class="font-monospace" style="font-size:12px">@l</td></tr> }
        @if (scanned.Length == 0) { <tr><td class="text-muted small">Chưa nạp dữ liệu.</td></tr> }
        </tbody></table>
    </div></div></div>

    @* Lưới 5 cột — nguồn CanNoAgentCode.cshtml:54-63 *@
    <div class="col-lg-8"><div class="card h-100"><div class="card-body">
        <table class="table table-sm table-hover align-middle">
            <thead><tr>
                <th style="width:48px">STT</th><th>Mã thùng</th><th>Mã đại lý</th>
                <th style="width:44px" class="text-center"><input type="checkbox" class="form-check-input" onclick="document.querySelectorAll('input[name=pick]:not(:disabled)').forEach(c=>c.checked=this.checked)" /></th>
                <th style="width:150px">Mã lỗi</th>
            </tr></thead>
            <tbody>
            @for (var i = 0; i < Model.Count; i++)
            {
                var r = Model[i];
                var bad = r.InputStatus != SerialFlag.Yes;
                <tr style="@(bad ? "color:#dc2626" : "")" title="@r.ErrMapName">
                    <td class="text-end">@(i + 1)</td>
                    <td class="font-monospace" style="font-size:12px">@r.CanNo</td>
                    <td>@r.AgentCode</td>
                    <td class="text-center"><input class="form-check-input" type="checkbox" name="pick" value="@i" @(bad ? "disabled" : "checked") /></td>
                    <td class="text-center small">@r.ErrMapCode</td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Lưới dữ liệu trống!</td></tr> }
            </tbody>
        </table>
        <button class="btn btn-primary" @(Model.Count == 0 ? "disabled" : "")><i class="bi bi-box-arrow-right me-1"></i>Xuất hàng</button>
    </div></div></div>
</div>
</form>
