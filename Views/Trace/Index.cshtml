@model TraceUnit?
@{
    Layout = null;
    ViewData["Title"] = "Truy xuất nguồn gốc";
    var code = (string?)ViewBag.Code ?? "";
    var events = Model?.Events.OrderBy(e => e.OccurredAt).ToList() ?? new();
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Truy xuất nguồn gốc — MiniTrace</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<style>
  body { background:#0f1207; min-height:100vh; font-family:"Be Vietnam Pro",sans-serif; padding:18px 12px; -webkit-font-smoothing:antialiased; }
  .wrap { max-width:460px; margin:0 auto; }
  .brand { color:#fff; text-align:center; font-weight:800; font-size:22px; margin-bottom:16px; } .brand span { color:#fde047; }
  .card { border:none; border-radius:16px; box-shadow:0 10px 40px rgba(0,0,0,.4); }
  .hero { background:linear-gradient(135deg,#ca8a04,#a16207); color:#fff; border-radius:16px 16px 0 0; padding:22px; text-align:center; }
  .tl { border-left:2px solid #e5e7eb; margin-left:8px; padding-left:20px; }
</style>
</head>
<body>
<div class="wrap">
  <div class="brand"><i class="bi bi-diagram-3-fill"></i> Mini<span>Trace</span> · Truy xuất nguồn gốc</div>
  <div class="card mb-3"><div class="card-body">
    <form method="get" action="/Trace" class="d-flex gap-2">
      <input name="code" value="@code" class="form-control" placeholder="Nhập mã truy xuất trên sản phẩm..." autofocus />
      <button class="btn btn-warning"><i class="bi bi-search"></i></button>
    </form>
  </div></div>

  @if (ViewBag.Code != null && Model == null)
  {
    <div class="card"><div class="card-body text-center py-5">
      <i class="bi bi-x-octagon text-danger" style="font-size:44px"></i>
      <h5 class="mt-2">Không tìm thấy mã</h5>
      <p class="text-muted small mb-0">Mã truy xuất không tồn tại — sản phẩm có thể không rõ nguồn gốc.</p>
    </div></div>
  }
  else if (Model != null)
  {
    <div class="card">
      <div class="hero">
        <div style="font-size:44px"><i class="bi bi-patch-check-fill"></i></div>
        <h4 class="fw-bold mb-1">@Model.Product.Name</h4>
        <div style="opacity:.9">Xuất xứ: @Model.Product.Origin · Lô @Model.LotNo</div>
      </div>
      <div class="card-body">
        <div class="text-muted small mb-3">Hành trình sản phẩm (@events.Count bước):</div>
        <div class="tl">
          @foreach (var e in events)
          {
            var (txt, css, icon) = Ui.Stage(e.Type);
            <div class="mb-3 position-relative">
              <span class="position-absolute" style="left:-29px;top:0"><i class="bi @icon text-@css" style="font-size:18px;background:#fff"></i></span>
              <div class="fw-semibold">@txt</div>
              <div class="small text-muted">@e.OccurredAt.ToString("dd/MM/yyyy HH:mm") · @e.Actor</div>
              <div class="small">@e.Location @if (!string.IsNullOrEmpty(e.Note)) { <span class="text-muted">— @e.Note</span> }</div>
            </div>
          }
        </div>
        <div class="alert alert-success small mb-0 mt-2"><i class="bi bi-shield-check me-1"></i>Thông tin do <b>@Model.Product.Manufacturer</b> công bố, minh bạch chuỗi cung ứng.</div>
      </div>
    </div>
  }
  <div class="text-center mt-3" style="color:#5c5540;font-size:12px">MiniTrace — truy xuất nguồn gốc chuẩn GS1 (CTE/KDE)</div>
</div>
</body>
</html>
