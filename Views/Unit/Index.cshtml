@model List<TraceUnit>
@{ ViewData["Title"] = "Đơn vị truy xuất"; var products = (List<Product>)ViewBag.Products; }
<div class="row g-3">
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Tạo đơn vị truy xuất</h6>
        @if (products.Count == 0) { <div class="alert alert-warning small">Thêm <a href="/Product">sản phẩm</a> trước.</div> }
        else
        {
            <form asp-action="Create" method="post">@Html.AntiForgeryToken()
                <div class="mb-2"><select name="productId" class="form-select" required><option value="">— Chọn SP —</option>@foreach (var p in products) { <option value="@p.Id">@p.Name</option> }</select></div>
                <div class="mb-3"><input name="lotNo" class="form-control" placeholder="Số lô SX" /></div>
                <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Tạo (mã QR truy xuất)</button>
            </form>
        }
    </div></div></div>
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <form method="get" class="mb-3" style="max-width:320px"><input name="q" value="@ViewBag.Q" class="form-control form-control-sm" placeholder="Mã / lô / sản phẩm..." /></form>
        <table class="table table-hover align-middle">
            <thead><tr><th>Mã truy xuất</th><th>Sản phẩm</th><th>Lô</th><th>Giai đoạn hiện tại</th></tr></thead>
            <tbody>
            @foreach (var u in Model)
            {
                var stage = u.LastStage.HasValue ? Ui.Stage(u.LastStage.Value) : ("—", "secondary", "");
                <tr style="cursor:pointer" onclick="location.href='/Unit/Detail/@u.Id'">
                    <td style="font-family:monospace" class="fw-semibold"><a href="/Trace?code=@u.Code" target="_blank">@u.Code</a></td>
                    <td>@u.Product.Name</td><td class="small">@u.LotNo</td>
                    <td><span class="badge bg-@stage.Item2">@stage.Item1</span></td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-4">Chưa có đơn vị truy xuất.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
</div>
